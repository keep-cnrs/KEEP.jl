# Acronym list (glossaries package, \printglossaries in main.tex): run makeglossaries,
# in the output directory when latexmk is called with -outdir.
add_cus_dep('acn', 'acr', 0, 'makeglossaries');
add_cus_dep('glo', 'gls', 0, 'makeglossaries');
$clean_ext .= ' acr acn alg glo gls glg ist';
sub makeglossaries {
    my ($base_name, $path) = fileparse($_[0]);
    my @args = ('-q');
    push @args, '-d', $path if $path;
    return system('makeglossaries', @args, $base_name);
}
