% Comments
\newcommand{\alter}[1]{
    \@latex@warning{alter [#1]}
    \textcolor{brown}{[#1]}
}
\newcommand{\addcite}[1]{
    \@latex@warning{addcite [#1]}
    \textcolor{ForestGreen}{[#1]}
}

