% Comments
\newcommand{\alter}[1]{
    \@latex@warning{alter [#1]}
    \textcolor{brown}{[#1]}
}
\newcommand{\addcite}[1]{
    \@latex@warning{addcite [#1]}
    \textcolor{ForestGreen}{[#1]}
}

% Math expressions
\newcommand{\vq}{\vb q}
\newcommand{\dq}{\dot{\vq}}
\newcommand{\ddq}{\ddot{\vq}}
\newcommand{\du}{\dot{\vb u}}

\newcommand{\dg}{\dot{\vb g}}
\newcommand{\ddg}{\ddot{\vb g}}

\newcommand{\R}{\mathbf{R}}

