\newcommand{\dq}{\dot{\vq}}
\newcommand{\ddq}{\ddot{\vq}}
\newcommand{\du}{\dot{\vb u}}

\newcommand{\df}{\dot{\vb f}}
\newcommand{\dg}{\dot{\vb g}}
\newcommand{\ddg}{\ddot{\vb g}}
\newcommand{\tf}{\tilde f}
\newcommand{\tg}{\tilde g}
\newcommand{\dtg}{\dot{\tg}}
\newcommand{\ddtg}{\ddot{\tg}}

\newcommand{\R}{\mathbf{R}}
\newcommand{\vbl}{\bm{\ell}}
\newcommand{\vul}{\hat{\vbl}}

